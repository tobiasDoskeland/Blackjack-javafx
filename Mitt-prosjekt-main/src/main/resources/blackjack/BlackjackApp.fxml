<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="background" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="500" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="blackjack.Controller">
   <children>
      <Button layoutX="271.0" layoutY="300.0" mnemonicParsing="false" onAction="#handleButtonClick" text="Start Round" />
      <Button layoutX="225.0" layoutY="188.0" mnemonicParsing="false" onAction="#hit" text="Hit" />
      <Button layoutX="325.0" layoutY="188.0" mnemonicParsing="false" onAction="#stand" text="Stand" />
      <TextField fx:id="bet" layoutX="25.0" layoutY="188.0" />
      <Button layoutX="50.0" layoutY="228.0" mnemonicParsing="false" onAction="#doubleBet" text="Double your bet" />

      <Button layoutX="20.0" layoutY="358.0" mnemonicParsing="false" onAction="#writeFile" text="Write results to file" />
      <Button layoutX="160.0" layoutY="358.0" mnemonicParsing="false" onAction="#loadFile" text="Load results from file" />
      <Label fx:id="fileText" layoutX="20.0" layoutY="400" text="results here..." />

      

      <Label fx:id="result" layoutX="457.0" layoutY="244.0" />
      <Label fx:id="resultString" layoutX="457.0" layoutY="200" />

      <Label fx:id = "your_cards" layoutX="271.0" layoutY="244.0" text="your cards here..."/>
      <Label fx:id = "your_score" layoutX="271.0" layoutY="264.0" text="your score here..."/>
      
      <Label fx:id = "dealer_cards" layoutX="271.0" layoutY="74.0" text="dealers cards here..."/>
      <Label fx:id = "dealer_score" layoutX="271.0" layoutY="54.0" text="dealers score here..."/>

      <Text layoutX="70.0" layoutY="161.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Your Bet" />
      <Text layoutX="70.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Balance" />
      <Label fx:id = "saldo" layoutX="70.0" layoutY="100.0" text="500"/>
   </children>
</AnchorPane>
